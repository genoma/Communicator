{
  "name": "@vioni/communicator",
  "version": "5.4.0",
  "description": "Terminal-first AI chat client for OpenRouter and Venice.ai with streaming responses, session persistence, and cost tracking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genoma/Communicator.git"
  },
  "homepage": "https://github.com/genoma/Communicator#readme",
  "bugs": {
    "url": "https://github.com/genoma/Communicator/issues"
  },
  "author": "Alessandro Vioni",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "chat",
    "llm",
    "openrouter",
    "venice",
    "terminal"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "communicator": "./index.js"
  },
  "files": [
    "index.js",
    "src/",
    "docs/"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --experimental-test-coverage",
    "lint": "eslint .",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.1",
    "@inquirer/prompts": "^8.0.0",
    "commander": "^14.0.0",
    "dictionary-en": "^4.0.0",
    "markdown-it": "^14.3.0",
    "nspell": "^2.1.5",
    "string-width": "^8.2.2"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0"
  }
}
